{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resolve.local/contracts/item-proposal.v1.schema.json",
  "title": "Proposta de item estruturado (Resolve, v1)",
  "description": "Saída de extrator ou de modelo de IA para uma questão oficial. É sempre proposta: só vira item depois de revisão editorial (plano §5, passo 4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "source",
    "number",
    "foreign_language",
    "area",
    "stimulus_blocks",
    "command_blocks",
    "alternatives",
    "figures",
    "producer",
    "doubts"
  ],
  "properties": {
    "contract": {
      "const": "item-proposal/v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "booklet_file",
        "booklet_sha256",
        "day",
        "booklet",
        "pages"
      ],
      "properties": {
        "booklet_file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,120}\\.pdf$"
        },
        "booklet_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "booklet": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          }
        },
        "bbox_by_page": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    },
    "number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 180
    },
    "foreign_language": {
      "enum": [
        null,
        "ingles",
        "espanhol"
      ]
    },
    "area": {
      "enum": [
        "LC",
        "MT",
        "CN",
        "CH"
      ]
    },
    "stimulus_blocks": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "command_blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "alternatives": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ],
      "properties": {
        "A": {
          "$ref": "#/$defs/alternative"
        },
        "B": {
          "$ref": "#/$defs/alternative"
        },
        "C": {
          "$ref": "#/$defs/alternative"
        },
        "D": {
          "$ref": "#/$defs/alternative"
        },
        "E": {
          "$ref": "#/$defs/alternative"
        }
      }
    },
    "figures": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "page",
          "bbox_pt",
          "png_sha256"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/blockId"
          },
          "role": {
            "type": "string",
            "pattern": "^(texto-base/comando|alternativa [A-E])$"
          },
          "kind": {
            "enum": [
              "imagem",
              "figura",
              "tabela"
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "bbox_pt": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "png_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "tool",
        "version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "extrator",
            "modelo"
          ]
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "provider": {
          "type": "string",
          "maxLength": 60
        },
        "model": {
          "type": "string",
          "maxLength": 80
        },
        "prompt_version": {
          "type": "string",
          "maxLength": 40
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "modelo"
          }
        }
      },
      "then": {
        "required": [
          "provider",
          "model",
          "prompt_version"
        ]
      }
    },
    "doubts": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "maxLength": 400
      }
    }
  },
  "$defs": {
    "blockId": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,24}$"
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/blockId"
        },
        "type": {
          "enum": [
            "paragraph",
            "heading",
            "source",
            "image",
            "table",
            "formula"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 20000
        },
        "asset_ref": {
          "$ref": "#/$defs/blockId"
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "image"
          }
        }
      },
      "then": {
        "required": [
          "asset_ref"
        ]
      },
      "else": {
        "required": [
          "text"
        ]
      }
    },
    "alternative": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  }
}
